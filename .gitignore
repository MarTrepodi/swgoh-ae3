# Track only what is needed to build and release AE3.
# Everything at the root is ignored unless explicitly allowed below,
# which keeps design and working materials (GLOSSARY.md, docs/, .claude/,
# notes, scratch files) out of git without having to list each one.
/*

!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/crates/
!/.github/
!/LICENSE
!/README.md
!/CHANGELOG.md
!/release-plz.toml
!/packaging/
!/committed.toml
!/.githooks/
!/scripts/

# Build output, wherever it appears
target/

# egui_kittest writes these beside a snapshot that changed; only the
# reference <name>.png is tracked.
*.diff.png
*.new.png
*.old.png
